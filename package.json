{
	"name": "salesforce-e2e-tests",
	"version": "1.0.0",
	"description": "example playwright test automation project focused on salesforce",
	"keywords": [
		"salesforce",
		"playwright",
		"e2e-testing",
		"api-testing",
		"test-automation"
	],
	"type": "module",
	"engines": {
		"node": ">=24.20.0 <25"
	},
	"overrides": {
		"utf7": {
			"semver": "5.7.2"
		}
	},
	"author": "Dawid Dobrowolski SoftQA",
	"scripts": {
		"validation:check": "npm run compile:check && npm run lint:check && npm run format:check && npm run test:unit",
		"compile:check": "npx tsc --noEmit",
		"lint:check": "eslint .",
		"lint:fix": "eslint . --fix",
		"format:check": "prettier . --check",
		"format:fix": "prettier . --write",
		"test:unit": "tsx --test test/unit/*.test.ts",
		"test:all": "npx playwright test",
		"test:demo": "npx playwright test --project=demo",
		"test:regression": "npx playwright test --project=regression",
		"test:email": "npx playwright test --project=email",
		"test:specific-project": "npx playwright test --project=specific-project",
		"show:report": "npx playwright show-report test-reports/html"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/imap": "^0.8.43",
		"@types/node": "^24.13.6",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"husky": "^9.1.7",
		"prettier": "^3.9.8",
		"strip-ansi": "^7.2.0",
		"tsx": "^4.23.15",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.70.0"
	},
	"dependencies": {
		"@faker-js/faker": "^10.6.0",
		"@playwright/test": "1.63.0",
		"dotenv": "^18.0.1",
		"imap": "0.8.19",
		"jsforce": "^3.10.25"
	}
}
